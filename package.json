{
  "name": "expense-sharing-api",
  "version": "1.0.0",
  "description": "Billzer-like expense sharing platform API — groups, expenses, balances, minimum settlements. No auth.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "start:dev": "cross-env NODE_ENV=production node server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "migrate:devices": "cross-env NODE_ENV=development node scripts/migrate-device-ids.js",
    "ai:check": "cross-env NODE_ENV=development node scripts/check-ai.js",
    "mirror:check": "cross-env NODE_ENV=development node scripts/check-mirror.js",
    "draft:check": "cross-env NODE_ENV=development node scripts/check-draft.js",
    "join:check": "cross-env NODE_ENV=development node scripts/check-join-approval.js",
    "filters:check": "cross-env NODE_ENV=development node scripts/check-expense-filters.js",
    "ledger:check": "cross-env NODE_ENV=development node scripts/check-ledger-type-change.js",
    "mirror:backfill": "cross-env NODE_ENV=development node scripts/backfill-mirrors.js",
    "mirror:backfill:dry": "cross-env NODE_ENV=development node scripts/backfill-mirrors.js --dry",
    "nudge:test": "cross-env NODE_ENV=development node scripts/send-test-nudge.js",
    "nudge:dry": "cross-env NODE_ENV=development node scripts/send-test-nudge.js --dry",
    "tunel": "cross-env NODE_ENV=development node server.js --tunel",
    "date:check": "cross-env NODE_ENV=development node scripts/check-expense-date.js",
    "recovery:check": "cross-env NODE_ENV=development node scripts/check-group-recovery.js",
    "sheets:check": "cross-env NODE_ENV=development node scripts/check-sheets.js",
    "entitlement:check": "cross-env NODE_ENV=development node scripts/check-entitlement.js",
    "recurring:check": "cross-env NODE_ENV=development node scripts/check-recurring.js",
    "receipt:check": "cross-env NODE_ENV=development node scripts/check-receipt.js",
    "export:check": "cross-env NODE_ENV=development node scripts/check-export.js",
    "referral:check": "cross-env NODE_ENV=development node scripts/check-referral-reward.js",
    "migrate:ai-usage": "cross-env NODE_ENV=development node scripts/migrate-ai-usage.js",
    "blog:check": "cross-env NODE_ENV=development node scripts/check-blog.js"
  },
  "keywords": [
    "expense",
    "split",
    "settlement",
    "billzer"
  ],
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.2.3",
    "morgan": "^1.10.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14"
  }
}
